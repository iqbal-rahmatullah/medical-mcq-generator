# App environment
ENVIRONMENT=local
RETRIEVER_CACHE_PATH=.cache/retriever_cache.pkl

# Retrieval config
RETRIEVAL_MODE=bm25_only
BM25_CANDIDATES_TOP_N=200
RERANK_TOP_N=50
EVIDENCE_TOP_K=10
EVIDENCE_TOP_K_EXPANDED=20
FUSION_ENABLED=false
RRF_K=60

# LLM provider: gemini_sdk | openai_compatible | ollama | groq
LLM_PROVIDER=gemini_sdk
LLM_TIMEOUT_SEC=60
LLM_TEMPERATURE=0.2
LLM_TOP_P=1.0
LLM_MAX_COMPLETION_TOKENS=2048
LLM_JSON_MODE=true
LLM_MAX_ATTEMPTS=4
LLM_CANDIDATES=1
LLM_DEDUP_ATTEMPTS=2
LLM_REASONING_EFFORT=
LLM_STOP=
LLM_STREAM=false
OK_ONLY_MODE=true
OK_ONLY_MAX_ROUNDS=3
OK_ONLY_MAX_SECONDS=90
EVIDENCE_FIRST=true
EVIDENCE_FIRST_MAX_SENTENCES=2
EVIDENCE_FIRST_MAX_CHARS=600
QUESTION_BANK_PATH=app/logging/question_bank.jsonl
QUESTION_BANK_FALLBACK=true
QUESTION_BANK_WRITE_OK=true
QUESTION_BANK_ALLOW_ANY_TOPIC=false

# Reviewer (optional; defaults to LLM_* when empty)
REVIEWER_ENABLED=true
REVIEWER_PROVIDER=
REVIEWER_API_KEY=
REVIEWER_API_BASE=
REVIEWER_MODEL=
REVIEWER_TIMEOUT_SEC=60

# Gemini config (google-genai)
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-2.5-flash-lite

# OpenAI-compatible config (e.g., OpenAI, Groq via OpenAI compat)
# LLM_PROVIDER=openai_compatible
# LLM_API_BASE=https://api.groq.com/openai/v1/chat/completions
# LLM_MODEL=openai/gpt-oss-120b

# Groq Cloud (SDK)
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# Ollama (local)
# LLM_PROVIDER=ollama
# LLM_API_BASE=http://localhost:11434
# LLM_MODEL=qwen3:8b

# Corpus (HF datasets)
CORPUS_PUBMED_HF_DATASET=MedRAG/pubmed
CORPUS_TEXTBOOKS_HF_DATASET=MedRAG/textbooks
CORPUS_HF_LOCAL_ONLY=true
CORPUS_HF_STREAMING=true
CORPUS_PUBMED_MAX_DOCS=2000
CORPUS_TEXTBOOKS_MAX_DOCS=0

# PubMed web fallback
PUBMED_WEB_ENABLED=false
PUBMED_WEB_MAX_RESULTS=10
PUBMED_WEB_TIMEOUT_SEC=10
PUBMED_API_KEY=
PUBMED_EMAIL=

# NLI evaluation (entailment)
NLI_MODEL=pritamdeka/PubMedBERT-MNLI-MedNLI

# Semantic evaluation (embedding similarity)
SEMANTIC_MODEL=microsoft/BiomedNLP-PubMedBERT-base-uncased-abstract-fulltext
