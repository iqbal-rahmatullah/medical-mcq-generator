# Retrieval config
RETRIEVAL_MODE=bm25_only
BM25_CANDIDATES_TOP_N=200
RERANK_TOP_N=50
EVIDENCE_TOP_K=5
FUSION_ENABLED=false
RRF_K=60

# Gemini config
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-2.5-flash-lite
LLM_TIMEOUT_SEC=60

# Corpus (HF datasets)
CORPUS_PUBMED_HF_DATASET=MedRAG/pubmed
CORPUS_TEXTBOOKS_HF_DATASET=MedRAG/textbooks
CORPUS_HF_LOCAL_ONLY=true
CORPUS_HF_STREAMING=true
CORPUS_PUBMED_MAX_DOCS=2000
CORPUS_TEXTBOOKS_MAX_DOCS=0
