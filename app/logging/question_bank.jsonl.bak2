{"topic": "GERD", "competency": "Therapy", "stem": "In lung transplant recipients who develop gastroesophageal reflux disease, which adjunctive therapy has been shown to improve post\u2011transplant pulmonary function?", "options": {"A": "Use of a novel sleep positioning device", "B": "High\u2011dose proton pump inhibitor therapy", "C": "Endoscopic esophageal dilation", "D": "Laparoscopic Nissen fundoplication"}, "answer_key": "A", "explanation": "A cohort study of lung transplant patients with GERD demonstrated that those who used a novel sleep positioning device had higher forced expiratory volume (FEV1) at 6 months and 1 year compared with historical controls receiving only proton pump inhibitors, indicating that the device can stabilize or improve pulmonary function as an adjunctive GERD therapy.", "evidence": [{"source": "pubmed_web", "doc_id": "pubmed_web_41564033", "title": "Impact of Sleep Positioning Device on Acid Exposure and Outcomes in Lung Transplant Recipients With Gastroesophageal Reflux Disease", "span_text": "Use of a novel SPD can stabilize or improve pulmonary function in patients with GERD after LT. SPD may be a safe and cost-effective adjunctive therapy for the management of GERD after LT."}], "status": "OK", "meta": {"retrieval": {"doc_ids": ["pubmed_web_41578529", "pubmed_web_41577482", "pubmed_web_41576548", "pubmed_web_41576321", "pubmed_web_41564033", "pubmed_web_41563645", "pubmed_web_41558065", "pubmed_web_41557001", "pubmed_web_41553382", "pubmed_web_41551831", "pubmed_web_41551533", "pubmed_web_41545289", "pubmed_web_41539580", "pubmed_web_41537290", "pubmed_web_41534397", "pubmed_web_41530072", "pubmed_web_41527695", "pubmed_web_41525274", "pubmed_web_41525031", "pubmed_web_41524830"], "evidence_doc_ids": ["pubmed_web_41576548", "pubmed_web_41576321", "pubmed_web_41564033", "pubmed_web_41563645", "pubmed_web_41558065", "pubmed_web_41557001", "pubmed_web_41553382", "pubmed_web_41551831", "pubmed_web_41551533", "pubmed_web_41545289", "pubmed_web_41539580", "pubmed_web_41537290", "pubmed_web_41534397", "pubmed_web_41530072", "pubmed_web_41527695", "pubmed_web_41525274", "pubmed_web_41525031", "pubmed_web_41524830", "pubmed_web_41578529", "pubmed_web_41577482"], "retrieval_mode": "pubmed_web"}, "verification": {"gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "pubmed_web_fallback", "query": "GERD Therapy therapy treatment management drug dosage medication pharmacotherapy first-line second-line guideline intervention acute management long-term management", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 8360.546500000055, "llm_ms": 1149.9667499997486, "verification_ms": 747.4328749999586, "extra_instructions": "", "retrieval_mode": "pubmed_web", "pubmed_web": {"attempted": true, "docs": 20, "runtime_ms": 3741.123875000085}, "status_counts": {"OK": 1, "INSUFFICIENT_EVIDENCE": 0, "FAILED_VERIFICATION": 0}, "failed_checks": [], "failed_checks_all": [], "evidence_doc_ids_used": ["pubmed_web_41576548", "pubmed_web_41576321", "pubmed_web_41564033", "pubmed_web_41563645", "pubmed_web_41558065", "pubmed_web_41557001", "pubmed_web_41553382", "pubmed_web_41551831", "pubmed_web_41551533", "pubmed_web_41545289", "pubmed_web_41539580", "pubmed_web_41537290", "pubmed_web_41534397", "pubmed_web_41530072", "pubmed_web_41527695", "pubmed_web_41525274", "pubmed_web_41525031", "pubmed_web_41524830", "pubmed_web_41578529", "pubmed_web_41577482"], "evidence_reused": false}]}, "timings_ms": {"retrieval": 8360.546500000055, "llm": 1149.9667499997486, "verification": 747.4328749999586}}}
{"topic": "GERD", "competency": "Therapy", "stem": "In lung transplant recipients with gastroesophageal reflux disease, which adjunctive therapy has been demonstrated to improve pulmonary function as measured by forced expiratory volume in 1 second (FEV1)?", "options": {"A": "Use of a novel sleep positioning device", "B": "Escalation of proton pump inhibitor dose", "C": "Endoscopic radiofrequency ablation of the lower esophageal sphincter", "D": "Implementation of a strict low\u2011fat diet"}, "answer_key": "A", "explanation": "The study showed that lung transplant recipients who used the novel sleep positioning device had higher % predicted FEV1 at 6 months and 1 year compared with controls on PPI alone, indicating that the device can stabilize or improve pulmonary function in this population.", "evidence": [{"source": "pubmed_web", "doc_id": "pubmed_web_41564033", "title": "Impact of Sleep Positioning Device on Acid Exposure and Outcomes in Lung Transplant Recipients With Gastroesophageal Reflux Disease", "span_text": "Use of a novel SPD can stabilize or improve pulmonary function in patients with GERD after LT. SPD may be a safe and cost-effective adjunctive therapy for the management of GERD after LT."}], "status": "OK", "meta": {"retrieval": {"doc_ids": ["pubmed_web_41578529", "pubmed_web_41577482", "pubmed_web_41576548", "pubmed_web_41576321", "pubmed_web_41564033", "pubmed_web_41563645", "pubmed_web_41558065", "pubmed_web_41557001", "pubmed_web_41553382", "pubmed_web_41551831", "pubmed_web_41551533", "pubmed_web_41545289", "pubmed_web_41539580", "pubmed_web_41537290", "pubmed_web_41534397", "pubmed_web_41530072", "pubmed_web_41527695", "pubmed_web_41525274", "pubmed_web_41525031", "pubmed_web_41524830"], "evidence_doc_ids": ["pubmed_web_41564033", "pubmed_web_41563645", "pubmed_web_41558065", "pubmed_web_41557001", "pubmed_web_41553382", "pubmed_web_41551831", "pubmed_web_41551533", "pubmed_web_41545289", "pubmed_web_41539580", "pubmed_web_41537290", "pubmed_