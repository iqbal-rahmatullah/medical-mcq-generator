{"topic": "Immunization", "competency": "Monitoring", "stem": "What is the primary purpose of monitoring adverse events following immunization?", "options": {"A": "To identify programmatic errors and document low risks", "B": "To assess the effectiveness of vaccines", "C": "To determine the optimal immunization schedule", "D": "To evaluate the cost-effectiveness of immunization programs"}, "answer_key": "A", "explanation": "Monitoring adverse events following immunization is essential to document low risks and to identify programmatic errors, if any, for corrective action.", "evidence": [{"source": "pubmed", "doc_id": "pubmed23n0058_10542", "title": "Adverse events following immunization: 1990", "span_text": "Monitoring of adverse events is essential to document low risks and to identify programmatic errors, if any, for corrective action."}], "status": "OK", "meta": {"retrieval": {"source": "pubmed", "query": "immunization monitoring", "doc_ids": ["pubmed23n0061_9715", "pubmed23n0056_16762", "pubmed23n0058_10542"], "evidence_doc_ids": ["pubmed23n0061_9715", "pubmed23n0056_16762", "pubmed23n0058_10542"], "retrieval_mode": "hybrid_rerank"}, "verification": {"method": "manual review", "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Immunization Monitoring monitoring follow-up treatment response labs imaging vital signs disease control therapeutic monitoring adverse effects dose adjustment clinical assessment outcome tracking", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 8369.00520796189, "llm_ms": 894.3634580355138, "verification_ms": 848.0849590268917, "extra_instructions": "", "retrieval_mode": "hybrid_rerank", "pubmed_web": {"attempted": false, "docs": 0, "runtime_ms": 0.0}, "status_counts": {"OK": 1, "INSUFFICIENT_EVIDENCE": 0, "FAILED_VERIFICATION": 0}, "failed_checks": [], "failed_checks_all": [], "evidence_doc_ids_used": ["pubmed23n0061_9715", "pubmed