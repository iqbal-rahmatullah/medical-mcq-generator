{"topic": "Neonatal sepsis", "competency": "Monitoring", "stem": "A newborn is diagnosed with neonatal sepsis due to Group B streptococcus. What is a common obstetric factor associated with this condition?", "options": {"A": "Maternal infection", "B": "Prolonged labor", "C": "Fetal distress", "D": "Placental abruption"}, "answer_key": "A", "explanation": "Maternal infection is a common obstetric factor associated with neonatal sepsis due to Group B streptococcus.", "evidence": [{"source": "pubmed", "doc_id": "pubmed23n0026_2595", "title": "Obstetric observations in eleven cases of neonatal sepsis due to the group B beta hemolytic streptococcus", "span_text": "Frequent observations associated with 8 surviving infants were maternal infection, early evaluation and treatment of the newborn, and 4+ or 5+ growth on maternal cultures."}], "status": "OK", "meta": {"retrieval": {"time": 100, "doc_ids": ["Obstentrics_Williams_6959", "Obstentrics_Williams_6440", "pubmed23n0018_2", "pubmed23n0027_952", "pubmed23n0026_2595", "Obstentrics_Williams_6492", "pubmed23n0015_10502", "pubmed23n0051_19883", "pubmed23n0022_4267", "pubmed23n0023_2891", "pubmed23n0020_7385", "pubmed23n0026_3412", "pubmed23n0036_11168", "pubmed23n0001_2951", "Obstentrics_Williams_3138", "Obstentrics_Williams_6702", "pubmed23n0062_9195", "pubmed23n0062_10388", "pubmed23n0062_17697"], "evidence_doc_ids": ["Obstentrics_Williams_6440", "pubmed23n0018_2", "pubmed23n0027_952", "pubmed23n0026_2595", "Obstentrics_Williams_6492", "pubmed23n0015_10502", "pubmed23n0051_19883", "pubmed23n0022_4267", "pubmed23n0023_2891", "pubmed23n0020_7385", "pubmed23n0026_3412", "pubmed23n0036_11168", "pubmed23n0001_2951", "Obstentrics_Williams_3138", "Obstentrics_Williams_6702", "pubmed23n0062_9195", "pubmed23n0062_10388", "pubmed23n0062_17697", "Obstentrics_Williams_6959"], "retrieval_mode": "hybrid_rerank"}, "verification": {"time": 200, "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "r