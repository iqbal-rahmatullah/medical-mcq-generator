{"topic": "Epilepsy", "competency": "Monitoring", "stem": "What is the primary goal of intensive monitoring techniques in patients with intractable epilepsy?", "options": {"A": "To reduce the frequency of seizures", "B": "To improve social adjustment", "C": "To decrease toxicity", "D": "To determine the cause of epilepsy"}, "answer_key": "A", "explanation": "Intensive monitoring techniques are used to improve seizure diagnosis and control in patients with intractable epilepsy. The primary goal is to reduce the frequency of seizures and improve seizure control.", "evidence": [{"source": "pubmed", "doc_id": "pubmed23n0019_5346", "title": "Diagnostic and therapeutic reevaluation of patients with intractable epilepsy", "span_text": "Intensive monitoring techniques were used to improve seizure diagnosis and control in 23 patients with intractable epilepsy: (1) Video recording of clinical seizures and the ictal EEG, (2) long-term telemetered EEG recordings, and (3) frequent determination of plasma antiepileptic drug concentrations."}], "status": "OK", "meta": {"retrieval": {"time": 100, "doc_ids": ["pubmed23n0019_5346", "pubmed23n0018_6980", "pubmed23n0052_4583", "pubmed23n0063_11497", "pubmed23n0045_852", "pubmed23n0043_10090", "pubmed23n0049_14789", "pubmed23n0060_12439", "pubmed23n0048_4264", "pubmed23n0051_813", "pubmed23n0043_2522", "pubmed23n0027_1635", "pubmed23n0045_289", "pubmed23n0009_857", "pubmed23n0058_128", "pubmed23n0040_11005", "pubmed23n0049_10496"], "evidence_doc_ids": ["pubmed23n0019_5346", "pubmed23n0018_6980", "pubmed23n0052_4583", "pubmed23n0063_11497", "pubmed23n0045_852", "pubmed23n0043_10090", "pubmed23n0049_14789", "pubmed23n0060_12439", "pubmed23n0048_4264", "pubmed23n0051_813", "pubmed23n0043_2522", "pubmed23n0027_1635", "pubmed23n0045_289", "pubmed23n0009_857", "pubmed23n0058_128", "pubmed23n0040_11005", "pubmed23n0049_10496"], "retrieval_mode": "hybrid_rerank"}, "verification": {"time": 200, "gate": {"pass": true, "failed_checks": [], "notes"