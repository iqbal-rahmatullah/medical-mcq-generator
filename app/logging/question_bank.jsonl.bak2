{"topic": "Anemia", "competency": "Screening", "stem": "Which enzymatic disorder is the most common cause of anemia worldwide?", "options": {"A": "Glucose-6-phosphate dehydrogenase deficiency", "B": "Pyruvate kinase deficiency", "C": "Hereditary spherocytosis", "D": "Beta\u2011thalassemia"}, "answer_key": "A", "explanation": "G6PD deficiency is the most common enzymatic disorder that leads to anemia, as it impairs redox balance and reduces NADPH production.", "evidence": [{"source": "pubmed_web", "doc_id": "pubmed_web_41568578", "title": "Glucose-6-phosphate dehydrogenase deficiency is associated with improved survival in patients with acute myeloid leukemia treated with venetoclax and azacitidine", "span_text": "Glucose-6-phosphate dehydrogenase (G6PD) deficiency impairs cellular redox balance through reduced NADPH production and is the most common enzymatic disorder-causing anemia."}], "status": "OK", "meta": {"retrieval": {"doc_ids": ["pubmed_web_41581178", "pubmed_web_41579563", "pubmed_web_41578542", "pubmed_web_41578473", "pubmed_web_41578285", "pubmed_web_41578103", "pubmed_web_41577641", "pubmed_web_41577474", "pubmed_web_41577460", "pubmed_web_41576199", "pubmed_web_41575919", "pubmed_web_41575164", "pubmed_web_41575124", "pubmed_web_41573536", "pubmed_web_41572859", "pubmed_web_41572165", "pubmed_web_41571391", "pubmed_web_41568594", "pubmed_web_41568578", "pubmed_web_41568533"], "evidence_doc_ids": ["pubmed_web_41568578", "pubmed_web_41568533", "pubmed_web_41581178", "pubmed_web_41579563", "pubmed_web_41578542", "pubmed_web_41578473", "pubmed_web_41578285", "pubmed_web_41578103", "pubmed_web_41577641", "pubmed_web_41577474", "pubmed_web_41577460", "pubmed_web_41576199", "pubmed_web_41575919", "pubmed_web_41575164", "pubmed_web_41575124", "pubmed_web_41573536", "pubmed_web_41572859", "pubmed_web_41572165", "pubmed_web_41571391", "pubmed_web_41568594"], "retrieval_mode": "pubmed_web"}, "verification": {"gate": {"pass": true, "failed_checks": [], "notes": []