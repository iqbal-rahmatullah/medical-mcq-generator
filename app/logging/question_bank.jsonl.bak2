{"topic": "Asthma", "competency": "Prognosis", "stem": "What is a significant predictor of fast progressive disease in patients with asthma?", "options": {"A": "Lower maximal expiratory flow at 50% of expired volume", "B": "Higher maximal expiratory flow at 50% of expired volume", "C": "Increased pack years", "D": "Improved quality of life"}, "answer_key": "A", "explanation": "A lower maximal expiratory flow at 50% of expired volume is related to an increased risk of fast progressive disease in both asthma and chronic bronchitis.", "evidence": [{"source": "pubmed", "doc_id": "pubmed23n0054_20323", "title": "Early detection of patients with fast progressive asthma or chronic bronchitis in general practice.", "span_text": "A lower maximal expiratory flow at 50% of expired volume (MEF50) was related to an increased risk of FPD in both asthma and chronic bronchitis (relative risks of 16.8 and 8.0 respectively, p less than 0.05)."}], "status": "OK", "meta": {"retrieval": {"time": 100, "doc_ids": ["Obstentrics_Williams_7112", "Obstentrics_Williams_1010", "InternalMed_Harrison_31956", "pubmed23n0054_20323", "Obstentrics_Williams_7116", "Obstentrics_Williams_6994"], "evidence_doc_ids": ["Obstentrics_Williams_7112", "Obstentrics_Williams_1010", "InternalMed_Harrison_31956", "pubmed23n0054_20323", "Obstentrics_Williams_7116", "Obstentrics_Williams_6994"], "retrieval_mode": "hybrid_rerank"}, "verification": {"time": 200, "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Asthma Prognosis prognosis outcomes mortality survival complications disease course recurrence risk stratification severity long-term outcomes quality of life predictors", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 10106.427291000728, "llm_ms": 1455.2888339967467, "verification_ms": 1166.054958011955, "extra_instructions": "", "retrieval_mode": "hybrid_rerank", "pubmed_web": {"attempted": false, "docs