{"topic": "COVID-19", "competency": "Etiology", "stem": "What percentage of individuals develop irritable bowel syndrome (IBS) after SARS-CoV-2 infection?", "options": {"A": "5.2%", "B": "7.2%", "C": "9.1%", "D": "11.5%"}, "answer_key": "B", "explanation": "Recent evidence indicates that approximately 7.2% of individuals develop IBS after SARS-CoV-2 infection.", "evidence": [{"source": "pubmed_web", "doc_id": "pubmed_web_41578455", "title": "Post-Coronavirus Disease (COVID)-19 Irritable Bowel Syndrome: What We've Learned So Far", "span_text": "Recent evidence indicates that approximately 7.2% of individuals develop IBS after SARS-CoV-2 infection, with 2.6-fold higher odds vs. non-infected controls."}], "status": "OK", "meta": {"retrieval": {"time": 100, "doc_ids": ["pubmed_web_41579008", "pubmed_web_41578924", "pubmed_web_41578736", "pubmed_web_41578501", "pubmed_web_41578455", "pubmed_web_41578061", "pubmed_web_41576644", "pubmed_web_41576149", "pubmed_web_41576069", "pubmed_web_41576058", "pubmed_web_41576003", "pubmed_web_41575326", "pubmed_web_41575059", "pubmed_web_41574613", "pubmed_web_41574459", "pubmed_web_41574300", "pubmed_web_41574293", "pubmed_web_41574291", "pubmed_web_41573794", "pubmed_web_41573760"], "evidence_doc_ids": ["pubmed_web_41579008", "pubmed_web_41578924", "pubmed_web_41578736", "pubmed_web_41578501", "pubmed_web_41578455", "pubmed_web_41578061", "pubmed_web_41576644", "pubmed_web_41576149", "pubmed_web_41576069", "pubmed_web_41576058", "pubmed_web_41576003", "pubmed_web_41575326", "pubmed_web_41575059", "pubmed_web_41574613", "pubmed_web_41574459", "pubmed_web_41574300", "pubmed_web_41574293", "pubmed_web_41574291", "pubmed_web_41573794", "pubmed_web_41573760"], "retrieval_mode": "pubmed_web"}, "verification": {"time": 50, "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "COVID-19 Etiology etiology cause risk factors pathogenesis mechanism underlying cause genetic f