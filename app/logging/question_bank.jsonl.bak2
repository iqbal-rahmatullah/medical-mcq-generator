{"topic": "diet", "competency": "Monitoring", "stem": "A 25-year-old woman with phenylketonuria is planning to conceive. What is crucial for improving her reproductive outcome?", "options": {"A": "Treatment with and careful monitoring of a phenylalanine-restricted diet", "B": "Discontinuation of her current diet and adoption of a new one", "C": "Regular exercise and stress management", "D": "Avoiding certain drugs and medications"}, "answer_key": "A", "explanation": "Careful monitoring of a phenylalanine-restricted diet can improve reproductive outcome in women with phenylketonuria.", "evidence": [{"source": "pubmed", "doc_id": "pubmed23n0050_1058", "title": "Nurses' role in preventing birth defects in offspring of women with phenylketonuria", "span_text": "Treatment with and careful monitoring of a phenylalanine-restricted diet can improve reproductive outcome."}], "status": "OK", "meta": {"retrieval": {"time": 100, "doc_ids": ["pubmed23n0052_3732", "pubmed23n0004_10454", "pubmed23n0050_1058", "InternalMed_Harrison_9412", "Pharmacology_Katzung_3803"], "evidence_doc_ids": ["pubmed23n0052_3732", "pubmed23n0004_10454", "pubmed23n0050_1058", "InternalMed_Harrison_9412", "Pharmacology_Katzung_3803"], "retrieval_mode": "hybrid_rerank"}, "verification": {"time": 50, "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "diet Monitoring monitoring follow-up treatment response labs imaging vital signs disease control therapeutic monitoring adverse effects dose adjustment clinical assessment outcome tracking", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 10744.864624983165, "llm_ms": 1382.350083993515, "verification_ms": 1099.0338750125375, "extra_instructions": "", "status_counts": {"OK": 1, "INSUFFICIENT_EVIDENCE": 0, "FAILED_VERIFICATION": 0}, "failed_checks": [], "failed_checks_all": [], "evidence_doc_ids_used": ["pubmed23n0052_3732", "pubmed23n0004_10454", "pubmed23n