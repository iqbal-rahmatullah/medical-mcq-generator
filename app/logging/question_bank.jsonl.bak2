{"topic": "Dengue", "competency": "Pharmacology", "stem": "What is the primary method of dengue transmission?", "options": {"A": "Mosquito transmission", "B": "Contaminated food and water", "C": "Direct human-to-human contact", "D": "Airborne transmission"}, "answer_key": "A", "explanation": "Dengue is primarily transmitted through the bite of an infected mosquito, specifically the Aedes aegypti mosquito.", "evidence": [{"source": "pubmed_web", "doc_id": "pubmed_web_41579379", "title": "Exploring knowledge, attitudes, and preventive practices related to dengue fever control: a cross-sectional study of 1,016 individuals", "span_text": "Dengue fever is a growing global health concern, especially in regions like the United Arab Emirates (UAE), where environmental factors and high levels of international travel increase the risk of outbreaks."}], "status": "OK", "meta": {"retrieval": {"time": 100, "doc_ids": ["pubmed_web_41579379", "pubmed_web_41557736", "pubmed_web_41538926", "pubmed_web_41532888", "pubmed_web_41531540", "pubmed_web_41490850", "pubmed_web_41481638", "pubmed_web_41477465", "pubmed_web_41472722", "pubmed_web_41472308", "pubmed_web_41472110", "pubmed_web_41463368", "pubmed_web_41461430", "pubmed_web_41460106", "pubmed_web_41453168", "pubmed_web_41449204", "pubmed_web_41444907", "pubmed_web_41444593", "pubmed_web_41442864", "pubmed_web_41436756"], "evidence_doc_ids": ["pubmed_web_41579379", "pubmed_web_41557736", "pubmed_web_41538926", "pubmed_web_41532888", "pubmed_web_41531540", "pubmed_web_41490850", "pubmed_web_41481638", "pubmed_web_41477465", "pubmed_web_41472722", "pubmed_web_41472308", "pubmed_web_41472110", "pubmed_web_41463368", "pubmed_web_41461430", "pubmed_web_41460106", "pubmed_web_41453168", "pubmed_web_41449204", "pubmed_web_41444907", "pubmed_web_41444593", "pubmed_web_41442864", "pubmed_web_41436756"], "retrieval_mode": "pubmed_web"}, "verification": {"time": 50, "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history":