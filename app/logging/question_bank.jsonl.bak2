{"topic": "Stroke", "competency": "Treatment", "stem": "What is the primary goal of therapeutic intervention in acute ischemic stroke?", "options": {"A": "To reduce complications of a recent stroke or prevent recurrences", "B": "To salvage damaged, but viable, tissue", "C": "To prevent infarction in areas of the brain that are still viable", "D": "To manage hypertension, hypercholesterolemia, and diabetes"}, "answer_key": "B", "explanation": "Therapeutic intervention in acute ischemic stroke must be directed at salvaging damaged, but viable, tissue.", "evidence": [{"source": "pubmed", "doc_id": "pubmed23n0056_16328", "title": "Pathophysiology of stroke", "span_text": "Therapeutic intervention in acute ischemic stroke must be directed at salvaging damaged, but viable, tissue."}], "status": "OK", "meta": {"retrieval": {"time": 100, "doc_ids": ["pubmed23n0052_2664", "pubmed23n0062_10201", "pubmed23n0062_10204", "pubmed23n0049_16234", "InternalMed_Harrison_21652", "pubmed23n0045_10082", "pubmed23n0059_18003", "pubmed23n0046_5630", "pubmed23n0052_17297", "Surgery_Schwartz_12249", "First_Aid_Step2_601", "pubmed23n0056_16328", "pubmed23n0063_15233"], "evidence_doc_ids": ["pubmed23n0052_2664", "pubmed23n0062_10201", "pubmed23n0062_10204", "pubmed23n0049_16234", "InternalMed_Harrison_21652", "pubmed23n0045_10082", "pubmed23n0059_18003", "pubmed23n0046_5630", "pubmed23n0052_17297", "Surgery_Schwartz_12249", "First_Aid_Step2_601", "pubmed23n0056_16328", "pubmed23n0063_15233"], "retrieval_mode": "hybrid_rerank"}, "verification": {"time": 50, "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Stroke Treatment treatment therapy management drug dosage medication pharmacotherapy first-line second-line guideline intervention acute management long-term management", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 8155.474582978059, "llm_ms": 1235.9131250414066, "verification_ms": 