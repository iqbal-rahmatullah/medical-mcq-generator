, "pubmed23n0027_2657", "pubmed23n0012_11495", "pubmed23n0046_4582", "Surgery_Schwartz_2737", "pubmed23n0047_3343", "pubmed23n0064_382", "pubmed23n0021_5995", "pubmed23n0033_6669", "pubmed23n0048_1969", "pubmed23n0056_18314", "pubmed23n0043_4563", "pubmed23n0004_7383", "InternalMed_Harrison_18270"], "evidence_doc_ids": ["pubmed23n0053_17698", "pubmed23n0052_8305", "pubmed23n0048_7202", "InternalMed_Harrison_18242", "pubmed23n0050_13944", "pubmed23n0048_156", "pubmed23n0028_9430", "pubmed23n0057_20992", "pubmed23n0053_15536", "pubmed23n0030_8211", "pubmed23n0062_12627", "pubmed23n0043_106", "pubmed23n0057_24131", "pubmed23n0056_8954", "pubmed23n0049_17582", "pubmed23n0034_8056", "pubmed23n0027_15054", "pubmed23n0062_3549", "pubmed23n0061_16482", "pubmed23n0031_76"], "retrieval_mode": "hybrid_rerank"}, "verification": {"method": "direct_quote_match", "confidence": "high", "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Myocardial infarction Complications complications adverse outcomes sequelae comorbidity disease progression risk factors mortality morbidity hospitalization long-term effects severity clinical deterioration", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 13498.645208999733, "llm_ms": 1251.4947499998925, "verification_ms": 1465.1689999996051, "extra_instructions": "", "retrieval_mode": "hybrid_rerank", "pubmed_web": {"attempted": false, "docs": 0, "runtime_ms": 0.0}, "status_counts": {"OK": 1, "INSUFFICIENT_EVIDENCE": 0, "FAILED_VERIFICATION": 0}, "failed_checks": [], "failed_checks_all": [], "evidence_doc_ids_used": ["pubmed23n0053_17698", "pubmed23n0052_8305", "pubmed23n0048_7202", "InternalMed_Harrison_18242", "pubmed23n0050_13944", "pubmed23n0048_156", "pubmed23n0028_9430", "pubmed23n0057_20992", "pubmed23n0053_15536", "pubmed23n0030_8211", "pubmed23n0062_12627", "pubmed23n0043_106", "pubmed23n0057_24131", "pubmed23n0056_8954", "pubmed23n004