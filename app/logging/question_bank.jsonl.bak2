{"topic": "Allergic rhinitis", "competency": "Screening", "stem": "What is the most efficient approach for screening patients with suspected allergic rhinitis?", "options": {"A": "Specific allergen tests", "B": "Total IgE determination", "C": "Skin prick test alone", "D": "Nasal challenge tests alone"}, "answer_key": "A", "explanation": "Specific tests seem to be more efficient for screening patients with suspected allergic rhinitis, as they provide a higher positive predictive value and sensitivity compared to total IgE determination.", "evidence": [{"source": "pubmed", "doc_id": "pubmed23n0054_17200", "title": "Allergic rhinopathy: Magic Lite SQ Allergy Screen Inhalant and CAP-FEIA SX1--comparison of two allergen-specific screening tests in serum", "span_text": "Although total IgE determination in the diagnosis of allergic rhinitis has been proposed for screening, specific tests seem to be more efficient."}], "status": "OK", "meta": {"retrieval": {"method": "database search", "doc_ids": ["pubmed23n0054_17200"], "evidence_doc_ids": ["pubmed23n0054_17200"], "retrieval_mode": "hybrid_rerank"}, "verification": {"method": "expert review", "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Allergic rhinitis Screening screening early detection risk assessment screening test sensitivity specificity guideline population screening high-risk preventive care follow-up diagnostic threshold", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 6097.163416969124, "llm_ms": 1341.5148750063963, "verification_ms": 780.6314170011319, "extra_instructions": "", "retrieval_mode": "hybrid_rerank", "pubmed_web": {"attempted": false, "docs": 0, "runtime_ms": 0.0}, "status_counts": {"OK": 1, "INSUFFICIENT_EVIDENCE": 0, "FAILED_VERIFICATION": 0}, "failed_checks": [], "failed_checks_all": [], "evidence_doc_ids_used": ["pubmed23n0054_17200"], "evidence_reused": false}]}, "timings_ms": {"retri