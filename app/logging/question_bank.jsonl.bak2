{"topic": "Cirrhosis", "competency": "Therapy", "stem": "What is the effect of low-dosage heparin therapy on consumption coagulopathy in patients with progressive liver cirrhosis?", "options": {"A": "Significant increase in fibrinogen and platelet count within 14 days", "B": "Decrease in prothrombin complex", "C": "No change in coagulopathy", "D": "Increase in bleeding risk"}, "answer_key": "A", "explanation": "Low-dosage heparin therapy (LDHT) has been shown to halt consumption coagulopathy in patients with progressive liver cirrhosis, with a significant increase in fibrinogen and platelet count within 14 days in about 75% of patients.", "evidence": [{"source": "pubmed", "doc_id": "pubmed23n0033_6670", "title": "The therapeutic management of consumption coagulopathy in progressive liver cirrhosis: low-dosage heparin therapy (author's transl)", "span_text": "A significant increase in fibrinogen and platelet count was obtained within 14 days of LDHT in about 75% of the patients and the consumption coagulopathy was halted."}], "status": "OK", "meta": {"retrieval": {"method": "database search", "doc_ids": ["pubmed23n0033_6670"], "evidence_doc_ids": ["pubmed23n0033_6670"], "retrieval_mode": "hybrid_rerank"}, "verification": {"method": "expert review", "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Cirrhosis Therapy therapy treatment management drug dosage medication pharmacotherapy first-line second-line guideline intervention acute management long-term management", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 12816.595209005754, "llm_ms": 819.0583329997025, "verification_ms": 716.7701249709353, "extra_instructions": "", "retrieval_mode": "hybrid_rerank", "pubmed_web": {"attempted": false, "docs": 0, "runtime_ms": 0.0}, "status_counts": {"OK": 1, "INSUFFICIENT_EVIDENCE": 0, "FAILED_VERIFICATION": 0}, "failed_checks": [], "failed_checks_all": [], "evidence_doc