{"topic": "Obesity", "competency": "Monitoring", "stem": "What is a condition that may require monitoring of low molecular weight heparin (LMWH) in patients?", "options": {"A": "Obesity", "B": "Hypertension", "C": "Diabetes", "D": "Hyperlipidemia"}, "answer_key": "A", "explanation": "LMWH monitoring is advisable in patients with obesity to ensure that there is no drug accumulation.", "evidence": [{"source": "textbook", "doc_id": "InternalMed_Harrison_9387", "title": "InternalMed_Harrison", "span_text": "Indications for LMWH monitoring include renal insufficiency and obesity."}], "status": "OK", "meta": {"retrieval": {"source": "database", "doc_ids": ["InternalMed_Harrison_9387", "pubmed23n0040_730"], "evidence_doc_ids": ["InternalMed_Harrison_9387", "pubmed23n0040_730"], "retrieval_mode": "hybrid_rerank"}, "verification": {"method": "manual", "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Obesity Monitoring monitoring follow-up treatment response labs imaging vital signs disease control therapeutic monitoring adverse effects dose adjustment clinical assessment outcome tracking", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 6827.558874996612, "llm_ms": 933.3331249981711, "verification_ms": 1614.27333300162, "extra_instructions": "", "retrieval_mode": "hybrid_rerank", "pubmed_web": {"attempted": false, "docs": 0, "runtime_ms": 0.0}, "status_counts": {"OK": 1, "INSUFFICIENT_EVIDENCE": 0, "FAILED_VERIFICATION": 0}, "failed_checks": [], "failed_checks_all": [], "evidence_doc_ids_used": ["InternalMed_Harrison_9387", "pubmed23n0040_730"], "evidence_reused": false}]}, "timings_ms": {"retrieval": 10.0, "verification": 20.0, "llm": 933.3331249981711}}}
{"topic": "Stroke", "competency": "Investigation", "stem": "What is the primary imaging modality used to confirm arterial occlusion in acute ischemic stroke?", "options": {"A": "Noncontrast head computed tomography (CT) scan", "B": "Magnetic resonance angiography (MRA) or CT angiography", "C": "MRI with diffusion-weighted imaging", "D": "Venography by MRI or CT"}, "answer_key": "B", "explanation": "Magnetic resonance angiography (MRA) or CT angiography is used to confirm arterial occlusion in acute ischemic stroke and can identify underlying arteriopathy, vascular malformations, and aneurysms.", "evidence": [{"source": "textbook", "doc_id": "Pediatrics_Nelson_3881", "title": "Pediatrics_Nelson", "span_text": "Angiography by magnetic resonance angiography (MRA) or CT angiography is used to confirm arterial occlusion in AIS and can identify underlying arteriopathy, vascular malformations, and aneurysms."}], "status": "OK", "meta": {"retrieval": {"method": "keyword search", "doc_ids": ["Pediatrics_Nelson_3881", "pubmed23n0013_1159", "pubmed23n0015_9223", "pubmed23n0046_23864"], "evidence_doc_ids": ["Pediatrics_Nelson_3881", "pubmed23n0013_1159", "pubmed23n0015_9223", "pubmed23n0046_23864"], "retrieval_mode": "hybrid_rerank"}, "verification": {"method": "expert review", "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Stroke Investigation investigation diagnostic test laboratory findings imaging workup evaluation differential diagnosis clinical criteria biomarkers screening confirmatory test diagnostic accuracy", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 5671.757124997384, "llm_ms": 1010.3855829984241, "verification_ms": 2351.997666999523, "extra_instructions": "", "retrieval_mode": "hybrid_rerank", "pubmed_web": {"attempted": false, "docs": 0, "runtime_ms": 0.0}, "status_counts": {"OK": 1, "INSUFFICIENT_EVIDENCE": 0, "FAILED_VERIFICATION": 0}, "failed_check