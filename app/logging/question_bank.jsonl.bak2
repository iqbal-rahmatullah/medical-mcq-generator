{"topic": "Acne", "competency": "Pharmacology", "stem": "What is a potential side effect of danazol treatment?", "options": {"A": "Weight loss", "B": "Acne", "C": "Decreased hair growth", "D": "Improved libido"}, "answer_key": "B", "explanation": "Danazol can cause various side effects, including acne and oily skin.", "evidence": [{"source": "textbook", "doc_id": "Pharmacology_Katzung_4569", "title": "Pharmacology_Katzung", "span_text": "The major adverse effects are weight gain, edema, decreased breast size, acne and oily skin, increased hair growth, deepening of the voice, headache, hot flushes, changes in libido, and muscle cramps."}], "status": "OK", "meta": {"retrieval": {"time": 10, "doc_ids": ["Pharmacology_Katzung_4569", "Pharmacology_Katzung_6806", "Pharmacology_Katzung_6750", "Pharmacology_Katzung_4434", "Pharmacology_Katzung_6705"], "evidence_doc_ids": ["Pharmacology_Katzung_4569", "Pharmacology_Katzung_6806", "Pharmacology_Katzung_6750", "Pharmacology_Katzung_4434", "Pharmacology_Katzung_6705"], "retrieval_mode": "hybrid_rerank"}, "verification": {"time": 5, "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Acne Pharmacology pharmacology drug mechanism indication contraindication adverse effects drug interaction dosage pharmacokinetics pharmacodynamics monitoring toxicity therapeutic target", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 6542.94629197102, "llm_ms": 1258.522957970854, "verification_ms": 1072.3332919878885, "extra_instructions": "", "retrieval_mode": "hybrid_rerank", "pubmed_web": {"attempted": false, "docs": 0, "runtime_ms": 0.0}, "status_counts": {"OK": 1, "INSUFFICIENT_EVIDENCE": 0, "FAILED_VERIFICATION": 0}, "failed_checks": [], "failed_checks_all": [], "evidence_doc_ids_used": ["Pharmacology_Katzung_4569", "Pharmacology_Katzung_6806", "Pharmacology_Katzung_6750", "Pharmacology_Katzung_4434", "Pharmacology_Katzung_6705"], "evide