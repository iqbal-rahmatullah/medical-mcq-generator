{"topic": "Neuroblastoma", "competency": "Screening", "stem": "What is the reported detection rate of neuroblastoma by mass screening among infants tested in Miyagi Prefecture?", "options": {"A": "1:8,377", "B": "1:10,000", "C": "1:5,000", "D": "1:20,000"}, "answer_key": "A", "explanation": "The detection rate of neuroblastoma by mass screening was reported to be 1:8,377 among 125,652 infants tested in Miyagi Prefecture.", "evidence": [{"source": "pubmed", "doc_id": "pubmed23n0043_15835", "title": "Mass screening for neuroblastoma in Miyagi Prefecture", "span_text": "The detection rate of neuroblastoma by mass screening was 1:8,377 among 125,652 infants tested in Miyagi Prefecture."}], "status": "OK", "meta": {"retrieval": {"method": "exact_match", "doc_ids": ["pubmed23n0048_16481", "pubmed23n0055_21585", "pubmed23n0038_11401", "pubmed23n0043_15835", "pubmed23n0062_5236"], "evidence_doc_ids": ["pubmed23n0062_5236", "pubmed23n0048_16481", "pubmed23n0055_21585", "pubmed23n0038_11401", "pubmed23n0043_15835"], "retrieval_mode": "hybrid_rerank"}, "verification": {"method": "manual_review", "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Neuroblastoma Screening screening early detection risk assessment screening test sensitivity specificity guideline population screening high-risk preventive care follow-up diagnostic threshold", "evidence_top_k": 30, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 7364.7467920091, "llm_ms": 912.2427919937763, "verification_ms": 881.8847079965053, "extra_instructions": "", "retrieval_mode": "hybrid_rerank", "pubmed_web": {"attempted": false, "docs": 0, "runtime_ms": 0.0}, "status_counts": {"OK": 0, "INSUFFICIENT_EVIDENCE": 0, "FAILED_VERIFICATION": 1}, "failed_checks": ["reviewer_mismatch"], "failed_checks_all": ["reviewer_mismatch"], "evidence_doc_ids_used": ["pubmed23n0062_5236", "pubmed23n0048_16481", "pubmed23n0055_21585", "pubmed23n0038_11401", "pub