{"topic": "Hyperthyroidism", "competency": "Complications", "stem": "What is a potential complication of untreated hyperthyroidism in pregnant women?", "options": {"A": "Preeclampsia", "B": "Gestational diabetes", "C": "Hypertension", "D": "Pulmonary embolism"}, "answer_key": "A", "explanation": "Untreated hyperthyroidism in pregnant women can lead to several complications, including preeclampsia, heart failure, and adverse perinatal outcomes.", "evidence": [{"source": "textbook", "doc_id": "Obstentrics_Williams_8051", "title": "Obstentrics_Williams", "span_text": "In untreated women or in those who remain hyperthyroid despite therapy, incidences of preeclampsia, heart failure, and adverse perinatal outcomes are higher (Table 58-2)."}], "status": "OK", "meta": {"retrieval": {"method": "keyword search", "doc_ids": ["Pediatrics_Nelson_1179", "pubmed23n0002_11711", "Obstentrics_Williams_8051", "InternalMed_Harrison_584", "pubmed23n0057_17794"], "evidence_doc_ids": ["Pediatrics_Nelson_1179", "pubmed23n0002_11711", "Obstentrics_Williams_8051", "InternalMed_Harrison_584", "pubmed23n0057_17794"], "retrieval_mode": "hybrid_rerank"}, "verification": {"method": "expert review", "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Hyperthyroidism Complications complications adverse outcomes sequelae comorbidity disease progression risk factors mortality morbidity hospitalization long-term effects severity clinical deterioration", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 6538.656582997646, "llm_ms": 967.727749957703, "verification_ms": 892.2724170261063, "extra_instructions": "", "retrieval_mode": "hybrid_rerank", "pubmed_web": {"attempted": false, "docs": 0, "runtime_ms": 0.0}, "status_counts": {"OK": 1, "INSUFFICIENT_EVIDENCE": 0, "FAILED_VERIFICATION": 0}, "failed_checks": [], "failed_checks_all": [], "evidence_doc_ids_used": ["Pediatrics_Nelson_1179", "pubmed23n000