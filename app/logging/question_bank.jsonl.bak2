{"topic": "Maternal Health", "competency": "Complications", "stem": "What is the primary concern for women with congenital heart disease during pregnancy, in terms of maternal mortality rates?", "options": {"A": "They have a lower risk of maternal mortality compared to unaffected women", "B": "They have a similar risk of maternal mortality compared to unaffected women", "C": "They have a higher risk of maternal mortality, with rates of 17.8 per 10,000 deliveries", "D": "They have a higher risk of maternal mortality, but only if they have a history of cardiovascular complications"}, "answer_key": "C", "explanation": "Women with congenital heart disease have a higher risk of maternal mortality, with rates of 17.8 per 10,000 deliveries, compared to unaffected women who have a rate of 0.7 per 10,000 deliveries.", "evidence": [{"source": "textbook", "doc_id": "Obstentrics_Williams_6743", "title": "Obstentrics_Williams", "span_text": "Maternal mortality rates were greater for women with congenital heart disease than for unafected gravidas-17.8 and 0.7 per 10,000 deliveries, respectively."}], "status": "OK", "meta": {"retrieval": {"source": "textbook", "doc_ids": ["Obstentrics_Williams_3656", "Pediatrics_Nelson_239", "pubmed23n0024_1190", "Obstentrics_Williams_6743", "pubmed23n0018_1674"], "evidence_doc_ids": ["Obstentrics_Williams_6743", "pubmed23n0018_1674", "Obstentrics_Williams_3656", "Pediatrics_Nelson_239", "pubmed23n0024_1190"], "retrieval_mode": "hybrid_rerank"}, "verification": {"method": "manual", "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Maternal Health Complications complications adverse outcomes sequelae comorbidity disease progression risk factors mortality morbidity hospitalization long-term effects severity clinical deterioration", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 3580.9862909954973, "llm_ms": 1022.633999993559, "verification_ms"