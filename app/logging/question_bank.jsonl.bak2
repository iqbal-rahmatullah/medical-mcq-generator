{"topic": "Postpartum hemorrhage", "competency": "Diagnosis", "stem": "What is a risk factor for postpartum hemorrhage?", "options": {"A": "Placental migration before 30 gestational weeks", "B": "Placental migration after 30 gestational weeks", "C": "Multiple pregnancy", "D": "Gestational diabetes"}, "answer_key": "B", "explanation": "The migration of placenta even after 30 gestational weeks is a risk factor for postpartum hemorrhage.", "evidence": [{"source": "pubmed_web", "doc_id": "pubmed_web_41561133", "title": "The migration of placenta even after 30 gestational weeks is a risk factor for postpartum hemorrhage", "span_text": "The migration of placenta even after 30 gestational weeks is a risk factor for postpartum hemorrhage."}], "status": "OK", "meta": {"retrieval": {"time": 100, "doc_ids": ["pubmed_web_41575164", "pubmed_web_41565309", "pubmed_web_41561133", "pubmed_web_41558753", "pubmed_web_41557933", "pubmed_web_41552274", "pubmed_web_41548040", "pubmed_web_41545597", "pubmed_web_41541846", "pubmed_web_41537277", "pubmed_web_41530193", "pubmed_web_41519151", "pubmed_web_41517348", "pubmed_web_41511017", "pubmed_web_41507820", "pubmed_web_41506270", "pubmed_web_41505421", "pubmed_web_41503887", "pubmed_web_41501670", "pubmed_web_41492697"], "evidence_doc_ids": ["pubmed_web_41575164", "pubmed_web_41565309", "pubmed_web_41561133", "pubmed_web_41558753", "pubmed_web_41557933", "pubmed_web_41552274", "pubmed_web_41548040", "pubmed_web_41545597", "pubmed_web_41541846", "pubmed_web_41537277", "pubmed_web_41530193", "pubmed_web_41519151", "pubmed_web_41517348", "pubmed_web_41511017", "pubmed_web_41507820", "pubmed_web_41506270", "pubmed_web_41505421", "pubmed_web_41503887", "pubmed_web_41501670", "pubmed_web_41492697"], "retrieval_mode": "pubmed_web"}, "verification": {"time": 200, "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Postpartum hemorrhage Diagnosis diagnosis differential diagno