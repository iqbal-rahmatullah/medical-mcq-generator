{"topic": "Schizophrenia", "competency": "Diagnosis", "stem": "What is the primary method of diagnosis for schizophrenia?", "options": {"A": "Imaging studies", "B": "Clinical diagnosis of exclusion", "C": "Laboratory tests", "D": "Psychological testing"}, "answer_key": "B", "explanation": "Schizophrenia is a clinical diagnosis of exclusion, meaning that it is diagnosed based on the presence of certain symptoms and the exclusion of other potential causes.", "evidence": [{"source": "textbook", "doc_id": "Pediatrics_Nelson_443", "title": "Pediatrics_Nelson", "span_text": "No diagnostic tests or imaging studies are specific forschizophrenia. It is a clinical diagnosis of exclusion."}], "status": "OK", "meta": {"retrieval": {"method": "exact match", "doc_ids": ["pubmed23n0055_15229", "Pediatrics_Nelson_443", "pubmed23n0012_6735", "pubmed23n0045_5675", "pubmed23n0053_14802", "pubmed23n0037_4671", "pubmed23n0023_3904", "pubmed23n0038_708", "pubmed23n0026_2143", "Pediatrics_Nelson_441", "pubmed23n0015_2474", "Psichiatry_DSM-5_522", "pubmed23n0016_12023", "Psichiatry_DSM-5_517", "pubmed23n0048_4086", "pubmed23n0049_1307", "pubmed23n0054_17062", "pubmed23n0050_3852", "pubmed23n0023_3355", "pubmed23n0011_12866", "pubmed23n0043_7011", "pubmed23n0023_8628", "pubmed23n0040_2225", "pubmed23n0017_11012", "Psichiatry_DSM-5_511", "pubmed23n0028_5523", "pubmed23n0018_694", "pubmed23n0055_21885", "pubmed23n0045_5320", "pubmed23n0057_15091"], "evidence_doc_ids": ["pubmed23n0055_15229", "Pediatrics_Nelson_443", "pubmed23n0012_6735", "pubmed23n0045_5675", "pubmed23n0053_14802", "pubmed23n0037_4671", "pubmed23n0023_3904", "pubmed23n0038_708", "pubmed23n0026_2143", "Pediatrics_Nelson_441", "pubmed23n0015_2474", "Psichiatry_DSM-5_522", "pubmed23n0016_12023", "Psichiatry_DSM-5_517", "pubmed23n0048_4086", "pubmed23n0049_1307", "pubmed23n0054_17062", "pubmed23n0050_3852", "pubmed23n0023_3355", "pubmed23n0011_12866"], "retrieval_mode": "hybrid_rerank"}, "verification": {"method": "expert review"