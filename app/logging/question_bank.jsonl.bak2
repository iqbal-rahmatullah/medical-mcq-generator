{"topic": "Osteoarthritis", "competency": "Prognosis", "stem": "What is a significant long-term predictor of outcome for general quality-of-life measures in patients with osteoarthritis?", "options": {"A": "Mobility and physical activity aspects", "B": "Severity of osteoarthritis in radiographs", "C": "Postoperative femoro-tibial angle", "D": "Mild instability"}, "answer_key": "A", "explanation": "The mobility and physical activity aspects of the AIMS were significant long-term predictors of outcome for general quality-of-life measures in patients with osteoarthritis.", "evidence": [{"source": "pubmed", "doc_id": "pubmed23n0049_18986", "title": "One-year evaluation of cognitive-behavioral intervention in osteoarthritis", "span_text": "Multiple regression analysis demonstrated that the mobility and physical activity aspects of the AIMS were significant long-term predictors of outcome (1 year) for general quality-of-life measures."}], "status": "OK", "meta": {"retrieval": {"method": "database search", "doc_ids": ["pubmed23n0049_18986", "pubmed23n0052_13949"], "evidence_doc_ids": ["pubmed23n0049_18986", "pubmed23n0052_13949"], "retrieval_mode": "hybrid_rerank"}, "verification": {"method": "expert review", "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Osteoarthritis Prognosis prognosis outcomes mortality survival complications disease course recurrence risk stratification severity long-term outcomes quality of life predictors", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 37612.40366601851, "llm_ms": 1063.015583960805, "verification_ms": 3024.9530419823714, "extra_instructions": "", "retrieval_mode": "hybrid_rerank", "pubmed_web": {"attempted": false, "docs": 0, "runtime_ms": 0.0}, "status_counts": {"OK": 1, "INSUFFICIENT_EVIDENCE": 0, "FAILED_VERIFICATION": 0}, "failed_checks": [], "failed_checks_all": [], "evidence_doc_ids_used": ["pubmed23n0049_18986", "p