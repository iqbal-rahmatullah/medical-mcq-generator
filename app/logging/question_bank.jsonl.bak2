{"topic": "Migraine", "competency": "Diagnosis", "stem": "What is a key diagnostic criterion for migraine headache according to the International Headache Society?", "options": {"A": "Unilateral site and throbbing quality", "B": "Bilateral site and pressing quality", "C": "Unilateral site and pressing quality", "D": "Bilateral site and throbbing quality"}, "answer_key": "A", "explanation": "The International Headache Society criteria for migraine diagnosis include unilateral site and throbbing quality as key diagnostic features.", "evidence": [{"source": "pubmed", "doc_id": "pubmed23n0063_4418", "title": "Criteria for the diagnosis of migraine in clinical practice", "span_text": "For care of headache patients by primary care physicians, we propose that the diagnosis of migraine without aura (common migraine) is warranted if any two of the following symptoms are present: unilateral site, throbbing quality, nausea, photophobia or phonophobia."}], "status": "OK", "meta": {"retrieval": {"time": 100, "doc_ids": ["InternalMed_Harrison_30124", "pubmed23n0049_6708", "pubmed23n0059_7665", "InternalMed_Harrison_29874", "pubmed23n0063_3775", "pubmed23n0054_1505", "pubmed23n0063_4418", "pubmed23n0017_6049", "pubmed23n0060_3289", "pubmed23n0051_1704"], "evidence_doc_ids": ["InternalMed_Harrison_30124", "pubmed23n0049_6708", "pubmed23n0059_7665", "InternalMed_Harrison_29874", "pubmed23n0063_3775", "pubmed23n0054_1505", "pubmed23n0063_4418", "pubmed23n0017_6049", "pubmed23n0060_3289", "pubmed23n0051_1704"], "retrieval_mode": "hybrid_rerank"}, "verification": {"time": 200, "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Migraine Diagnosis diagnosis differential diagnosis signs symptoms screening clinical features presentation diagnostic criteria workup evaluation diagnostic test laboratory findings imaging", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 5487.978499964811, 