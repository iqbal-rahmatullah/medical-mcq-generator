{"topic": "Malaria", "competency": "Therapy", "stem": "What is the first-line therapy for the treatment of uncomplicated falciparum malaria in some countries in Asia?", "options": {"A": "Dihydroartemisinin-piperaquine", "B": "Quinine sulfate", "C": "Chloroquine", "D": "Mefloquine"}, "answer_key": "A", "explanation": "Dihydroartemisinin-piperaquine is now the first-line therapy for the treatment of uncomplicated falciparum malaria in some countries in Asia.", "evidence": [{"source": "textbook", "doc_id": "Pharmacology_Katzung_5688", "title": "Pharmacology_Katzung", "span_text": "Dihydroartemisinin-piperaquine is now the first-line therapy for the treatment of uncomplicated falciparum malaria in some countries in Asia."}], "status": "OK", "meta": {"retrieval": {"time": 100, "doc_ids": ["Pharmacology_Katzung_5704", "pubmed23n0058_11572", "pubmed23n0044_23398", "Pharmacology_Katzung_5688", "Pharmacology_Katzung_5209", "Pharmacology_Katzung_5178", "Pharmacology_Katzung_5711", "pubmed23n0048_15873"], "evidence_doc_ids": ["Pharmacology_Katzung_5704", "pubmed23n0058_11572", "pubmed23n0044_23398", "Pharmacology_Katzung_5688", "Pharmacology_Katzung_5209", "Pharmacology_Katzung_5178", "Pharmacology_Katzung_5711", "pubmed23n0048_15873"], "retrieval_mode": "hybrid_rerank"}, "verification": {"time": 50, "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Malaria Therapy therapy treatment management drug dosage medication pharmacotherapy first-line second-line guideline intervention acute management long-term management", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 6775.359124996612, "llm_ms": 869.3152499981807, "verification_ms": 819.2182499988121, "extra_instructions": "", "retrieval_mode": "hybrid_rerank", "pubmed_web": {"attempted": false, "docs": 0, "runtime_ms": 0.0}, "status_counts": {"OK": 1, "INSUFFICIENT_EVIDENCE": 0, "FAILED_VERIFICATION": 0}, "failed_checks": []