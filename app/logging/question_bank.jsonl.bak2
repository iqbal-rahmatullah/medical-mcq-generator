, "pubmed23n0048_17866", "pubmed23n0050_19018", "pubmed23n0051_2791", "pubmed23n0029_4861", "Surgery_Schwartz_9958", "Surgery_Schwartz_9712", "pubmed23n0036_4448", "pubmed23n0016_3392", "pubmed23n0050_14508", "pubmed23n0002_1107", "pubmed23n0017_11264", "pubmed23n0051_16228", "pubmed23n0046_19396", "pubmed23n0059_1967", "pubmed23n0060_18329", "pubmed23n0053_5110", "pubmed23n0052_20013", "pubmed23n0049_21035"], "evidence_doc_ids": ["InternalMed_Harrison_2200", "First_Aid_Step2_1063", "pubmed23n0048_9447", "pubmed23n0059_20077", "pubmed23n0014_2698", "Gynecology_Novak_3795", "pubmed23n0061_12104", "pubmed23n0060_3302", "Gynecology_Novak_3798", "pubmed23n0061_8767", "pubmed23n0058_459", "pubmed23n0045_10934", "pubmed23n0045_1660", "pubmed23n0060_3301", "pubmed23n0060_13879", "Pharmacology_Katzung_3094", "InternalMed_Harrison_25237", "pubmed23n0001_10283", "pubmed23n0057_15176", "pubmed23n0022_2751"], "retrieval_mode": "hybrid_rerank"}, "verification": {"sources_used": "pubmed23n0048_9447, pubmed23n0061_12104", "consistency": "high", "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Chronic obstructive pulmonary disease Treatment treatment therapy management drug dosage medication pharmacotherapy first-line second-line guideline intervention acute management long-term management", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 12662.10345799982, "llm_ms": 1237.3600000000806, "verification_ms": 1510.2083750002748, "extra_instructions": "", "retrieval_mode": "hybrid_rerank", "pubmed_web": {"attempted": false, "docs": 0, "runtime_ms": 0.0}, "status_counts": {"OK": 1, "INSUFFICIENT_EVIDENCE": 0, "FAILED_VERIFICATION": 0}, "failed_checks": [], "failed_checks_all": [], "evidence_doc_ids_used": ["InternalMed_Harrison_2200", "First_Aid_Step2_1063", "pubmed23n0048_9447", "pubmed23n0059_20077", "pubmed23n0014_2698", "Gynecology_Novak_3795", "pubmed23n0061_12104", "pubmed23n