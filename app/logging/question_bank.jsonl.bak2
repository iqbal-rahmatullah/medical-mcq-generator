{"topic": "Peptic ulcer disease", "competency": "Monitoring", "stem": "What is a significant risk factor for severe complications after peptic ulcer perforation repair?", "options": {"A": "Alcohol use history", "B": "Age of the patient", "C": "Location of the perforation", "D": "Type of surgical intervention"}, "answer_key": "A", "explanation": "Alcohol use history is identified as an independent risk factor for severe complications after peptic ulcer perforation repair.", "evidence": [{"source": "pubmed_web", "doc_id": "pubmed_web_41164391", "title": "Risk factors and predictive model construction for severe complications following repair of perforated peptic ulcer", "span_text": "Analytical results indicated that alcohol use history, ASA score, admission nutritional score, CRP level, and preoperative albumin level were independent risk factors for severe complications"}], "status": "OK", "meta": {"retrieval": {"method": "keyword search", "doc_ids": ["pubmed_web_41560759", "pubmed_web_41330871", "pubmed_web_41164391", "pubmed_web_41141122", "pubmed_web_41138484", "pubmed_web_41132750", "pubmed_web_41112146", "pubmed_web_41055229", "pubmed_web_40928782", "pubmed_web_40917343", "pubmed_web_40785810", "pubmed_web_40760615", "pubmed_web_40676408", "pubmed_web_40644760", "pubmed_web_40596880", "pubmed_web_40567214", "pubmed_web_40565802", "pubmed_web_40503451", "pubmed_web_40365732", "pubmed_web_40286638"], "evidence_doc_ids": ["pubmed_web_41560759", "pubmed_web_41330871", "pubmed_web_41164391", "pubmed_web_41141122", "pubmed_web_41138484", "pubmed_web_41132750", "pubmed_web_41112146", "pubmed_web_41055229", "pubmed_web_40928782", "pubmed_web_40917343", "pubmed_web_40785810", "pubmed_web_40760615", "pubmed_web_40676408", "pubmed_web_40644760", "pubmed_web_40596880", "pubmed_web_40567214", "pubmed_web_40565802", "pubmed_web_40503451", "pubmed_web_40365732", "pubmed_web_40286638"], "retrieval_mode": "pubmed_web"}, "verification": {"method": "manual review", "gate": {"pass