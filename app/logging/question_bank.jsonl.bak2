"pubmed23n0045_457", "pubmed23n0051_21851", "InternalMed_Harrison_19132", "pubmed23n0011_907", "pubmed23n0053_8975", "Pharmacology_Katzung_6415", "Obstentrics_Williams_1069", "InternalMed_Harrison_19633"], "evidence_reused": false}]}, "timings_ms": {"retrieval": 120.0, "generation": 65.0, "verification": 45.0, "llm": 1413.0715410001358}}}
{"topic": "Diabetes mellitus", "competency": "Complications", "stem": "A 58-year-old man with type 2 diabetes mellitus presents for preoperative evaluation prior to coronary artery bypass grafting. Which of the following is a well-established chronic complication of diabetes that increases his perioperative morbidity?", "options": {"A": "Coronary artery disease", "B": "Acute pancreatitis", "C": "Hepatic steatosis", "D": "Gout"}, "answer_key": "A", "explanation": "Chronic complications of diabetes mellitus include coronary artery disease, which significantly increases perioperative morbidity. Diabetes is a major risk factor for macrovascular disease, including coronary heart disease, due to accelerated atherosclerosis, endothelial dysfunction, and metabolic abnormalities.", "evidence": [{"source": "pubmed", "doc_id": "pubmed23n0062_12875", "title": "Pathophysiology of vascular disease in diabetes: effects of gliclazide.", "span_text": "Diabetes mellitus is a major risk factor for coronary heart disease, peripheral vascular disease, and cardiovascular disease. The prevalence of these complications is increased about two- to four-fold in people with diabetes in the United States, and they contribute substantially to morbidity, mortality, and healthcare costs."}], "status": "OK", "meta": {"retrieval": {"query": "diabetes chronic complications coronary artery disease", "doc_ids": ["pubmed23n0052_8305", "pubmed23n0047_5691", "pubmed23n0059_379", "pubmed23n0060_409", "pubmed23n0002_4932", "pubmed23n0062_12875", "pubmed23n0057_16827", "InternalMed_Harrison_27993", "pubmed23n0027_7422", "pubmed23n0056_16013", "Obstentrics_Williams_8008", "pubmed23n0042_12962", "pubmed23n0044_9135", "pubmed23n0049_10703", "InternalMed_Harrison_17394", "pubmed23n0061_16963", "pubmed23n0062_12872", "InternalMed_Harrison_30676", "Obstentrics_Williams_6591", "pubmed23n0056_19136", "pubmed23n0046_18247", "pubmed23n0045_8920", "pubmed23n0043_8772", "pubmed23n0033_10609", "pubmed23n0042_12960", "pub