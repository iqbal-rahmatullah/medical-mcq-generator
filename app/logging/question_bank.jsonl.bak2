{"topic": "Migraine", "competency": "Prognosis", "stem": "What is the potential long-term outcome for individuals with alternating hemiplegic migraine?", "options": {"A": "Long-term deterioration in cognitive and neurological function", "B": "Full recovery of cognitive and neurological function", "C": "No significant impact on cognitive and neurological function", "D": "Only temporary deterioration in cognitive and neurological function"}, "answer_key": "A", "explanation": "Alternating hemiplegic migraine can lead to long-term deterioration in cognitive and neurological function, resulting in significant and lasting impacts on an individual's quality of life.", "evidence": [{"source": "pubmed", "doc_id": "pubmed23n0061_11977", "title": "Alternating hemiplegic migraine in childhood", "span_text": "Alternating hemiplegic migraine results immediately in an incapacitated state and can lead to long-term deterioration in cognitive and neurological function."}], "status": "OK", "meta": {"retrieval": {"method": "database search", "doc_ids": ["pubmed23n0061_11977"], "evidence_doc_ids": ["pubmed23n0061_11977"], "retrieval_mode": "hybrid_rerank"}, "verification": {"method": "expert review", "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Migraine Prognosis prognosis outcomes mortality survival complications disease course recurrence risk stratification severity long-term outcomes quality of life predictors", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 11145.421333028935, "llm_ms": 1437.1951670036651, "verification_ms": 1060.0527910282835, "extra_instructions": "", "retrieval_mode": "hybrid_rerank", "pubmed_web": {"attempted": false, "docs": 0, "runtime_ms": 0.0}, "status_counts": {"OK": 1, "INSUFFICIENT_EVIDENCE": 0, "FAILED_VERIFICATION": 0}, "failed_checks": [], "failed_checks_all": [], "evidence_doc_ids_used": ["pubmed23n0061_11977"], "evidence_reused": false}]},