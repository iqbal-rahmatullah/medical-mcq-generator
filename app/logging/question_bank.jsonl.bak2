{"topic": "Smoking cessation", "competency": "Diagnosis", "stem": "A patient presents with symptoms of peptic ulcer, what risk factor should be considered during anamnestic evaluation?", "options": {"A": "Cigarette-smoking", "B": "High blood pressure", "C": "Diabetes", "D": "Asthma"}, "answer_key": "A", "explanation": "Cigarette-smoking is a known risk factor for peptic ulcers and should be considered during anamnestic evaluation to aid in differential diagnosis.", "evidence": [{"source": "pubmed", "doc_id": "pubmed23n0050_11279", "title": "Differential diagnosis of peptic ulcer", "span_text": "Accurate anamnestic evaluation will find out risk factors as cigarette-smoking, stress and therapy with nonsteroidal antiinflammatory drugs (NSAIDs), and will be helpful in differential diagnosis."}], "status": "OK", "meta": {"retrieval": {"method": "keyword search", "doc_ids": ["pubmed23n0050_11279", "Psichiatry_DSM-5_1501"], "evidence_doc_ids": ["pubmed23n0050_11279", "Psichiatry_DSM-5_1501"], "retrieval_mode": "hybrid_rerank"}, "verification": {"method": "manual review", "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Smoking cessation Diagnosis diagnosis differential diagnosis signs symptoms screening clinical features presentation diagnostic criteria workup evaluation diagnostic test laboratory findings imaging", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 12092.039500013925, "llm_ms": 1040.6062080292031, "verification_ms": 1060.713000013493, "extra_instructions": "", "retrieval_mode": "hybrid_rerank", "pubmed_web": {"attempted": false, "docs": 0, "runtime_ms": 0.0}, "status_counts": {"OK": 1, "INSUFFICIENT_EVIDENCE": 0, "FAILED_VERIFICATION": 0}, "failed_checks": [], "failed_checks_all": [], "evidence_doc_ids_used": ["pubmed23n0050_11279", "Psichiatry_DSM-5_1501"], "evidence_reused": false}]}, "timings_ms": {"retrieval": 100.0, "verification": 200.0, "llm": 1