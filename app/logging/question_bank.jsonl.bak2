{"topic": "Hyperthyroidism", "competency": "Monitoring", "stem": "What is the most reliable method of monitoring relapse in hyperthyroidism?", "options": {"A": "Serial estimations of serum T3", "B": "Serial estimations of serum T4", "C": "Clinical assessment", "D": "Thyroid-stimulating-hormone (T.S.H.) estimations"}, "answer_key": "A", "explanation": "Serial estimations of serum T3 provide the most reliable method of monitoring relapse in hyperthyroidism, as they can predict the subsequent development of clinical hyperthyroidism.", "evidence": [{"source": "pubmed", "doc_id": "pubmed23n0002_7704", "title": "Hormonal pattern of relapse in hyperthyroidism", "span_text": "It is concluded that serial estimations of serum T3 provide the most reliable method of monitoring relapse in hyperthyroidism."}], "status": "OK", "meta": {"retrieval": {"method": "keyword search", "doc_ids": ["pubmed23n0002_7704", "pubmed23n0057_23899", "pubmed23n0043_11799"], "evidence_doc_ids": ["pubmed23n0002_7704", "pubmed23n0057_23899", "pubmed23n0043_11799"], "retrieval_mode": "hybrid_rerank"}, "verification": {"method": "expert review", "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Hyperthyroidism Monitoring monitoring follow-up treatment response labs imaging vital signs disease control therapeutic monitoring adverse effects dose adjustment clinical assessment outcome tracking", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 10928.77708398737, "llm_ms": 1759.0047499979846, "verification_ms": 756.3061669934541, "extra_instructions": "", "retrieval_mode": "hybrid_rerank", "pubmed_web": {"attempted": false, "docs": 0, "runtime_ms": 0.0}, "status_counts": {"OK": 1, "INSUFFICIENT_EVIDENCE": 0, "FAILED_VERIFICATION": 0}, "failed_checks": [], "failed_checks_all": [], "evidence_doc_ids_used": ["pubmed23n0002_7704", "pubmed23n0057_23899", "pubmed23n0043_11799"], "evidence_reused": false}]}, "