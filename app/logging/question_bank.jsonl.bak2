{"topic": "Smoking cessation", "competency": "Treatment", "stem": "What is the primary pharmacologic method of choice for smoking cessation?", "options": {"A": "Nicotine administration via a transdermal system or polacrilex", "B": "Beta agonists", "C": "Mucolytics", "D": "Steroids"}, "answer_key": "A", "explanation": "Nicotine administration via a transdermal system or polacrilex is considered the primary pharmacologic method of choice for smoking cessation.", "evidence": [{"source": "pubmed", "doc_id": "pubmed23n0048_9447", "title": "COPD: primary care management with drug and oxygen therapies", "span_text": "Nicotine administration via a transdermal system or polacrilex is the pharmacologic method of choice for smoking cessation."}], "status": "OK", "meta": {"retrieval": {"method": "database search", "doc_ids": ["pubmed23n0048_9447", "pubmed23n0049_5143", "InternalMed_Harrison_23161", "InternalMed_Harrison_31965", "pubmed23n0056_1814", "pubmed23n0048_11867", "pubmed23n0056_13656", "pubmed23n0058_10942", "pubmed23n0062_4306", "pubmed23n0053_8807", "pubmed23n0046_8219", "Pharmacology_Katzung_1218", "pubmed23n0047_9520", "pubmed23n0044_21236", "pubmed23n0059_2445", "pubmed23n0055_16582", "pubmed23n0019_9650", "pubmed23n0062_4312", "pubmed23n0053_1722", "pubmed23n0043_5063", "pubmed23n0058_3904", "pubmed23n0051_9936"], "evidence_doc_ids": ["pubmed23n0048_9447", "pubmed23n0049_5143", "InternalMed_Harrison_23161", "InternalMed_Harrison_31965", "pubmed23n0056_1814", "pubmed23n0048_11867", "pubmed23n0056_13656", "pubmed23n0058_10942", "pubmed23n0062_4306", "pubmed23n0053_8807", "pubmed23n0046_8219", "Pharmacology_Katzung_1218", "pubmed23n0047_9520", "pubmed23n0044_21236", "pubmed23n0059_2445", "pubmed23n0055_16582", "pubmed23n0019_9650", "pubmed23n0062_4312", "pubmed23n0053_1722", "pubmed23n0043_5063"], "retrieval_mode": "hybrid_rerank"}, "verification": {"method": "expert review", "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1