{"topic": "Hypothyroidism", "competency": "Complications", "stem": "What is a potential complication of untreated hypothyroidism in pregnancy?", "options": {"A": "Preterm birth", "B": "Pulmonary fibrosis", "C": "Cardiac dysfunction", "D": "Breast cancer"}, "answer_key": "A", "explanation": "Untreated hypothyroidism in pregnancy can lead to adverse perinatal outcomes, including preterm birth.", "evidence": [{"source": "textbook", "doc_id": "Obstentrics_Williams_8071", "title": "Obstentrics_Williams", "span_text": "Preterm birth rates, for example, are higher (Sheehan, 2015)."}], "status": "OK", "meta": {"retrieval": {"source": "database", "doc_ids": ["Obstentrics_Williams_8071", "Gynecology_Novak_5668", "Pediatrics_Nelson_3358", "Obstentrics_Williams_8091"], "evidence_doc_ids": ["Obstentrics_Williams_8071", "Gynecology_Novak_5668", "Pediatrics_Nelson_3358", "Obstentrics_Williams_8091"], "retrieval_mode": "hybrid_rerank"}, "verification": {"method": "expert review", "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Hypothyroidism Complications complications adverse outcomes sequelae comorbidity disease progression risk factors mortality morbidity hospitalization long-term effects severity clinical deterioration", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 8486.817208002321, "llm_ms": 838.4186250041239, "verification_ms": 818.2682920014486, "extra_instructions": "", "retrieval_mode": "hybrid_rerank", "pubmed_web": {"attempted": false, "docs": 0, "runtime_ms": 0.0}, "status_counts": {"OK": 1, "INSUFFICIENT_EVIDENCE": 0, "FAILED_VERIFICATION": 0}, "failed_checks": [], "failed_checks_all": [], "evidence_doc_ids_used": ["Obstentrics_Williams_8071", "Gynecology_Novak_5668", "Pediatrics_Nelson_3358", "Obstentrics_Williams_8091"], "evidence_reused": false}]}, "timings_ms": {"retrieval": 10.0, "verification": 20.0, "llm": 838.4186250041239}}}
{"topic": "Hypothyroidism", "competency": "Diagnosis", "stem": "What is the most important tool for the early diagnosis of congenital hypothyroidism?", "options": {"A": "Newborn screening program", "B": "Clinical symptoms and signs", "C": "Laboratory studies", "D": "Family history"}, "answer_key": "A", "explanation": "The early diagnosis of congenital hypothyroidism is crucial for the prevention of mental impairment and other complications. A newborn screening program is the most effective way to detect congenital hypothyroidism early, as it can identify affected babies before they show any symptoms.", "evidence": [{"source": "pubmed", "doc_id": "pubmed23n0051_18962", "title": "Congenital hypothyroidism", "span_text": "Because of the lack of signs and symptoms in the first weeks of life, the most important tool for the early diagnosis of congenital hypothyroidism is a newborn screening program."}], "status": "OK", "meta": {"retrieval": {"method": "keyword search", "doc_ids": ["pubmed23n0007_7734", "pubmed23n0050_5671", "pubmed23n0014_14451", "pubmed23n0051_18962", "pubmed23n0049_6132", "pubmed23n0043_1250", "pubmed23n0058_14726", "Neurology_Adams_3452", "pubmed23n0008_7058", "pubmed23n0037_11998", "pubmed23n0043_15879"], "evidence_doc_ids": ["pubmed23n0007_7734", "pubmed23n0050_5671", "pubmed23n0014_14451", "pubmed23n0051_18962", "pubmed23n0049_6132", "pubmed23n0043_1250", "pubmed23n0058_14726", "Neurology_Adams_3452", "pubmed23n0008_7058", "pubmed23n0037_11998", "pubmed23n0043_15879"], "retrieval_mode": "hybrid_rerank"}, "verification": {"method": "expert review", "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Hypothyroidism Diagnosis diagnosis differential diagnosis signs symptoms screening clinical features presentation diagnostic criteria workup evaluation diagnostic test laboratory findings imaging", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 9584.