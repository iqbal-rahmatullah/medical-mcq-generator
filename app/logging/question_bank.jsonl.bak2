{"topic": "COVID-19", "competency": "Investigation", "stem": "What is the primary outcome measured in a multicenter prospective observational study on pre-intubation bag-valve-mask ventilation in the emergency department?", "options": {"A": "Peri-intubation hypoxemia", "B": "Regurgitation", "C": "Cardiac arrest", "D": "Pulmonary embolism"}, "answer_key": "A", "explanation": "The primary outcome measured in the study is peri-intubation hypoxemia, which is defined as an SpO\u2082 of less than 90%.", "evidence": [{"source": "pubmed_web", "doc_id": "pubmed_web_41579524", "title": "Association of pre-intubation bag-valve-mask ventilation with hypoxemia and regurgitation in the ED: A multicenter cohort study", "span_text": "The primary outcome was peri-intubation hypoxemia (SpO\u2082 <90%), and the secondary outcome was regurgitation."}], "status": "OK", "meta": {"retrieval": {"time": 100, "doc_ids": ["pubmed_web_41580715", "pubmed_web_41579524", "pubmed_web_41578924", "pubmed_web_41578410", "pubmed_web_41578296", "pubmed_web_41577420", "pubmed_web_41576992", "pubmed_web_41576702", "pubmed_web_41575948", "pubmed_web_41575299", "pubmed_web_41575210", "pubmed_web_41574613", "pubmed_web_41574291", "pubmed_web_41574175", "pubmed_web_41573785", "pubmed_web_41573760", "pubmed_web_41573439", "pubmed_web_41573280", "pubmed_web_41572075", "pubmed_web_41571402"], "evidence_doc_ids": ["pubmed_web_41580715", "pubmed_web_41579524", "pubmed_web_41578924", "pubmed_web_41578410", "pubmed_web_41578296", "pubmed_web_41577420", "pubmed_web_41576992", "pubmed_web_41576702", "pubmed_web_41575948", "pubmed_web_41575299", "pubmed_web_41575210", "pubmed_web_41574613", "pubmed_web_41574291", "pubmed_web_41574175", "pubmed_web_41573785", "pubmed_web_41573760", "pubmed_web_41573439", "pubmed_web_41573280", "pubmed_web_41572075", "pubmed_web_41571402"], "retrieval_mode": "pubmed_web"}, "verification": {"time": 200, "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attem