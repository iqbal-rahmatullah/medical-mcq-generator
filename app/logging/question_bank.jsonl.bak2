{"topic": "Epilepsy", "competency": "Complications", "stem": "What is a significant risk for children with epilepsy?", "options": {"A": "Cognitive impairment and behavioral abnormalities", "B": "Respiratory infections and non-infectious respiratory morbidity", "C": "Cardiovascular disease and hypertension", "D": "Gastrointestinal disorders and malnutrition"}, "answer_key": "A", "explanation": "Children with epilepsy are at significant risk for cognitive impairment and behavioral abnormalities due to the underlying pathology responsible for the seizures.", "evidence": [{"source": "pubmed", "doc_id": "pubmed23n0058_6593", "title": "Do seizures cause brain damage?", "span_text": "Children with epilepsy are at significant risk for cognitive impairment and behavioral abnormalities. In most children with epilepsy, the likely reason for cognitive impairment is the underlying pathology responsible for the seizures."}], "status": "OK", "meta": {"retrieval": {"time": 100, "doc_ids": ["pubmed23n0058_6593", "pubmed23n0055_404", "pubmed23n0006_2295"], "evidence_doc_ids": ["pubmed23n0058_6593", "pubmed23n0055_404", "pubmed23n0006_2295"], "retrieval_mode": "hybrid_rerank"}, "verification": {"time": 50, "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Epilepsy Complications complications adverse outcomes sequelae comorbidity disease progression risk factors mortality morbidity hospitalization long-term effects severity clinical deterioration", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 7149.158124997484, "llm_ms": 897.8452919982374, "verification_ms": 834.4154160004109, "extra_instructions": "", "retrieval_mode": "hybrid_rerank", "pubmed_web": {"attempted": false, "docs": 0, "runtime_ms": 0.0}, "status_counts": {"OK": 1, "INSUFFICIENT_EVIDENCE": 0, "FAILED_VERIFICATION": 0}, "failed_checks": [], "failed_checks_all": [], "evidence_doc_ids_used": ["pubmed23n0058_6593", "pu