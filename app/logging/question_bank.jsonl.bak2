{"topic": "Sepsis", "competency": "Monitoring", "stem": "What is the cornerstone of management in the Surviving Sepsis Campaign?", "options": {"A": "Early goal-directed management", "B": "Late goal-directed management", "C": "Prompt recognition of serious viral infection", "D": "Close monitoring of vital signs only"}, "answer_key": "A", "explanation": "The Surviving Sepsis Campaign stresses prompt recognition of serious bacterial infection and close monitoring of vital signs and urine flow, with early goal-directed management as its cornerstone.", "evidence": [{"source": "textbook", "doc_id": "Obstentrics_Williams_6492", "title": "Obstentrics_Williams", "span_text": "he cornerstone of management is eary goal-directed management, and it stresses prompt recognition of serious bacterial infection and close monitoring of vital signs and urine flow."}], "status": "OK", "meta": {"retrieval": {"source": "database", "doc_ids": ["Obstentrics_Williams_6440", "pubmed23n0027_952", "Obstentrics_Williams_6492", "pubmed23n0051_19883"], "evidence_doc_ids": ["Obstentrics_Williams_6440", "pubmed23n0027_952", "Obstentrics_Williams_6492", "pubmed23n0051_19883"], "retrieval_mode": "hybrid_rerank"}, "verification": {"method": "expert review", "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Sepsis Monitoring monitoring follow-up treatment response labs imaging vital signs disease control therapeutic monitoring adverse effects dose adjustment clinical assessment outcome tracking", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 10064.705416036304, "llm_ms": 900.180124968756, "verification_ms": 0.26741594774648547, "extra_instructions": "", "retrieval_mode": "hybrid_rerank", "pubmed_web": {"attempted": false, "docs": 0, "runtime_ms": 0.0}, "status_counts": {"OK": 0, "INSUFFICIENT_EVIDENCE": 0, "FAILED_VERIFICATION": 1}, "failed_checks": ["evidence_span_mismatch"], "failed_checks_all"