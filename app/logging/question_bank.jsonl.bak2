{"topic": "Postpartum hemorrhage", "competency": "Monitoring", "stem": "What is the primary indication for invasive hemodynamic monitoring in a postpartum patient?", "options": {"A": "To monitor serum gentamicin concentrations", "B": "To determine and monitor treatment in a critically ill patient", "C": "To assess the risk of postpartum depression", "D": "To evaluate the efficacy of antibiotic therapy"}, "answer_key": "B", "explanation": "Invasive hemodynamic monitoring is indicated in the critically ill pregnant or postpartum patient, whose hemodynamic state cannot be reliably determined by clinical observation and noninvasive methods.", "evidence": [{"source": "pubmed", "doc_id": "pubmed23n0060_10986", "title": "Invasive hemodynamic monitoring in pregnancy", "span_text": "Invasive hemodynamic monitoring is indicated in the critically ill pregnant or postpartum patient, whose hemodynamic state cannot be reliably determined by clinical observation and noninvasive methods."}], "status": "OK", "meta": {"retrieval": {"time": 100, "doc_ids": ["pubmed23n0048_15009", "pubmed23n0060_10986", "Obstentrics_Williams_4438", "pubmed23n0048_1849", "pubmed23n0053_15371"], "evidence_doc_ids": ["pubmed23n0048_15009", "pubmed23n0060_10986", "Obstentrics_Williams_4438", "pubmed23n0048_1849", "pubmed23n0053_15371"], "retrieval_mode": "hybrid_rerank"}, "verification": {"time": 50, "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Postpartum hemorrhage Monitoring monitoring follow-up treatment response labs imaging vital signs disease control therapeutic monitoring adverse effects dose adjustment clinical assessment outcome tracking", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 12214.226249954663, "llm_ms": 867.224708024878, "verification_ms": 823.9935419987887, "extra_instructions": "", "retrieval_mode": "hybrid_rerank", "pubmed_web": {"attempted": false, "docs": 0, "runtime_ms