{"topic": "Neonatal sepsis", "competency": "Prevention", "stem": "What is the primary method for preventing early-onset group B streptococcal sepsis in newborns?", "options": {"A": "Intrapartum antibiotic prophylaxis", "B": "Neonatal vaccination", "C": "Maternal vaccination before pregnancy", "D": "Universal rectovaginal culture screening alone"}, "answer_key": "A", "explanation": "Intrapartum antibiotic prophylaxis is the primary method for preventing early-onset group B streptococcal sepsis in newborns, as it significantly reduces the risk of transmission from mother to fetus during delivery.", "evidence": [{"source": "pubmed", "doc_id": "pubmed23n0054_16032", "title": "Prevention of neonatal group B streptococcal infections: advances in maternal vaccine development", "span_text": "The literature supports prophylactic use of intrapartum antibiotics in mothers who are known carriers of group B streptococcus but highlights the need for more sensitive rapid screening techniques to identify this high-risk population."}, {"source": "pubmed", "doc_id": "pubmed23n0062_1366", "title": "Intrapartum chemoprophylaxis of early-onset group B streptococcal disease", "span_text": "A randomized study in 121 pregnant women carrier of group B streptococci is undertaken in order to assess the administration of 500 mg of intrapartum ampicillin intravenously to interrupt mother-to-fetus group B streptococcal transmission."}], "status": "OK", "meta": {"retrieval": {"method": "database search", "query": "neonatal sepsis prevention", "doc_ids": ["pubmed23n0054_16032", "pubmed23n0041_11473", "pubmed23n0043_11737", "Obstentrics_Williams_8845", "pubmed23n0062_1366", "pubmed23n0049_18694", "pubmed23n0052_12053"], "evidence_doc_ids": ["pubmed23n0054_16032", "pubmed23n0041_11473", "pubmed23n0043_11737", "Obstentrics_Williams_8845", "pubmed23n0062_1366", "pubmed23n0049_18694", "pubmed23n0052_12053"], "retrieval_mode": "hybrid_rerank"}, "verification": {"method": "expert review", "result": "verified", "gate": {"pass": true, "failed_checks": [], "notes": []}, "attempt_history": [{"attempt": 1, "reason": "initial", "query": "Neonatal sepsis Prevention prevention prophylaxis risk reduction screening vaccination primary prevention secondary prevention lifestyle modification counseling public health early detection follow-up", "evidence_top_k": 20, "candidate_count": 1, "selected_index": 1, "retrieval_ms": 6049.754249979742, "llm_ms": 906.23099997174, "verification_ms": 1263.931416964624, "extra_instructions": "", "retrieval_mode": "hybrid_rerank", "pubmed_web": {"attempted": false, "docs": 0, "runtime_ms": 0.0}, "status_counts": {"OK": 1, "INSUFFICIENT_EVIDENCE": 0, "FAILED_VERIFICATION": 0}, "failed_checks": [], "failed_checks_all": [], "evidence_doc_ids_used": ["pubmed23n0054_16032", "pubmed23n0041_11473", "pubmed23n0043_11737", "Obstentrics_Williams_8845", "pubmed23n0062_1366", "pubmed23n0049_18694", "pubmed23n0052_12053"], "evidence_reused": false}]}, "timings_ms": {"retrieval": 100.0, "verification": 200.0, "llm": 906.23099997174}}}
{"topic": "Peptic ulcer disease", "competency": "Etiology", "stem": "What is a primary cause of active chronic gastritis in humans, which can lead to peptic ulcer disease?", "options": {"A": "Helicobacter pylori infection", "B": "Genetic predisposition", "C": "Environmental factors", "D": "Autoimmune disease"}, "answer_key": "A", "explanation": "Helicobacter pylori infection is recognized as the primary cause of active chronic gastritis in humans, and most infected persons are at increased risk for the development of peptic ulcer disease.", "evidence": [{"source": "pubmed", "doc_id": "pubmed23n0052_19614", "title": "Helicobacter pylori and gastroduodenal disease", "span_text": "Helicobacter pylori infection is now recognized as the primary cause of active chronic gastritis in humans. Most infected persons remain asymptomatic, but are at increased risk for the development of peptic ulcer disease and possibly gastric cancer."}], "status": "OK", "meta": {"retrieval": {"time": 100, "doc_ids": ["pubmed23n0028_7849", "Pathology_Robbins_180", "pubmed23n0052_7920", "pubmed23n0048_17127", "pubmed23n0048_15700", "pubmed23n0056_13372", "pubmed23n0025_10911", "pubmed23n0042_13893", "pubmed23n0052_19614", "pubmed23n0040_3741", "pubmed23n0011_8448", "Immunology_Janeway_3495", "InternalMed_Harrison_20246", "pubmed23n0041_8159", "pubmed23n0063_7485", "pubmed23n0054_14825", "InternalMed_Harrison_22525", "pubmed23n0045_1163", "pubmed23n0051_12056", "Surgery_Schwartz_8440", "pubmed23n0037_2404", "InternalMed_Harrison_7124", "InternalMed_Harrison_3038", "pubmed23n0036_1511", "pubmed23n0015_7079", "pubmed23n0046_16773", "InternalMed_Harrison_5626", "pubmed23n0033_4056", "pubmed23n0012_2888", "pubmed23n0062_981", "pubmed23n0037_2403", "InternalMed_Harrison_6983", "Immunology_Janeway_3832", "Immunology_Janeway_3902", "Surgery_Schwartz_9786", "pubmed23n0050_6755", "pubmed23n0062_6989", "pubmed23n0049_1606", "pubmed23n0047_3214", "pubmed23n0035_5483", "pubmed23n0054_12259", "pubmed23n0062_1